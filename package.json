{
  "name": "travel-planning-agent",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/bundle-single.mjs",
    "preview": "vite preview --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "esbuild scripts/eval.ts --bundle --platform=node --format=esm --outfile=scripts/eval.mjs --log-level=warning && node scripts/eval.mjs",
    "crawl": "esbuild server/crawler.ts --bundle --platform=node --format=esm --outfile=server/crawler.mjs --log-level=warning && node server/crawler.mjs",
    "crawl:watch": "esbuild server/crawler.ts --bundle --platform=node --format=esm --outfile=server/crawler.mjs --log-level=warning && node server/crawler.mjs --watch",
    "serve:build": "esbuild server/app.ts --bundle --platform=node --format=esm --outfile=server/app.mjs --log-level=warning",
    "serve": "npm run serve:build && node server/app.mjs",
    "resident": "node scripts/keepalive.mjs",
    "typecheck:server": "tsc -p tsconfig.server.json"
  },
  "dependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
